---
# Copy this file to group_vars/app_servers/vault.yml and encrypt it:
# ansible-vault encrypt group_vars/app_servers/vault.yml
#
# Do not commit the encrypted vault file unless you intentionally want to keep
# encrypted secrets in the repository.

app_secret_env: {}

